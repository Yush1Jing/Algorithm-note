{"config":{"lang":["zh","en"],"separator":"[\\s\\u200b\\u3000\\-\u3001\u3002\uff0c\uff0e\uff1f\uff01\uff1b]+","pipeline":["stemmer"],"fields":{"title":{"boost":1000.0},"text":{"boost":1.0},"tags":{"boost":1000000.0}}},"docs":[{"location":"","title":"Algorithm Notes","text":"<p>\u6211\u7684\u7b97\u6cd5\u4e0e\u5237\u9898\u5b66\u4e60\u8bb0\u5f55\uff1a\u4ece\u6570\u636e\u7ed3\u6784\u57fa\u7840\uff0c\u5230\u5e38\u89c1\u7b97\u6cd5\u5957\u8def\uff0c\u518d\u5230\u6bcf\u9053\u9898\u7684\u601d\u8def\u590d\u76d8\u3002</p>"},{"location":"#_1","title":"\u680f\u76ee","text":"\u680f\u76ee \u5185\u5bb9 \u5237\u9898\u65b9\u6cd5 \u77e5\u8bc6\u70b9\u6e05\u5355\u3001\u9898\u5e93\u8def\u7ebf\u3001\u6bcf\u9053\u9898\u7684\u6807\u51c6\u9762\u8bd5\u52a8\u4f5c \u6570\u636e\u7ed3\u6784 \u6bcf\u79cd\u7ed3\u6784\u80fd\u505a\u4ec0\u4e48\u3001\u64cd\u4f5c\u590d\u6742\u5ea6\u3001Python \u5199\u6cd5 \u7b97\u6cd5\u5957\u8def \u53cc\u6307\u9488\u3001BFS\u3001\u4e8c\u5206\u3001DP \u7b49\u6a21\u677f\u548c\u8bc6\u522b\u4fe1\u53f7 \u5237\u9898\u8bb0\u5f55 \u4e00\u9898\u4e00\u9875\uff1a\u66b4\u529b\u89e3 \u2192 \u74f6\u9888 \u2192 \u4f18\u5316 \u9519\u9898\u672c \u5361\u8fc7\u7684\u70b9\uff0c\u5b9a\u671f\u91cd\u505a"},{"location":"#_2","title":"\u5b66\u4e60\u539f\u5219","text":"<ul> <li>\u6a21\u677f\u8981\u80cc\uff0c\u601d\u8def\u8981\u61c2\uff1a\u80fd\u7528\u4e09\u53e5\u8bdd\u8bb2\u6e05\u201c\u4e3a\u4ec0\u4e48\u7528\u8fd9\u4e2a\u65b9\u6cd5\u201d\u624d\u7b97\u61c2</li> <li>\u540c\u7c7b\u9898\u8fde\u7740\u505a\uff0c\u5230\u7b2c 4\u30015 \u9053\u5f00\u59cb\u81ea\u5df1\u60f3\u5230</li> <li>\u6bcf\u9053\u9898\u90fd\u5199\uff1a\u66b4\u529b\u89e3\u662f\u4ec0\u4e48\u3001\u6162\u5728\u54ea\u3001\u600e\u4e48\u53bb\u6389\u91cd\u590d</li> </ul>"},{"location":"method/","title":"\u5237\u9898\u65b9\u6cd5","text":""},{"location":"method/#_2","title":"\u77e5\u8bc6\u70b9","text":"<ol> <li>\u6570\u7ec4 / \u5b57\u7b26\u4e32 + \u53cc\u6307\u9488\u3001\u6ed1\u52a8\u7a97\u53e3</li> <li>\u54c8\u5e0c\u8868</li> <li>\u4e8c\u5206\u67e5\u627e</li> <li>\u6808 / \u961f\u5217\u3001\u5355\u8c03\u6808</li> <li>\u94fe\u8868\uff08\u53cd\u8f6c\u3001\u5feb\u6162\u6307\u9488\u3001\u5408\u5e76\uff09</li> <li>\u4e8c\u53c9\u6811\uff08\u904d\u5386\u3001DFS / BFS\uff09</li> <li>\u5806 / Top K</li> <li>\u56fe\uff08BFS / DFS\u3001\u62d3\u6251\u6392\u5e8f\u3001\u5e76\u67e5\u96c6\uff09</li> <li>\u56de\u6eaf\uff08\u5b50\u96c6\u3001\u6392\u5217\u7ec4\u5408\uff09</li> <li>\u52a8\u6001\u89c4\u5212\uff08\u5b50\u5e8f\u5217\u3001\u80cc\u5305\u3001\u6253\u5bb6\u52ab\u820d\u3001\u80a1\u7968\u95ee\u9898\uff09</li> <li>\u524d\u7f00\u548c\u3001\u8d2a\u5fc3</li> <li>\u8bbe\u8ba1\u9898\uff08LRU \u7f13\u5b58\u8fd9\u7c7b\uff09</li> </ol>"},{"location":"method/#_3","title":"\u9898\u5e93","text":""},{"location":"method/#_4","title":"\u4e3b\u7ebf","text":"<ul> <li>LeetCode Hot 100\uff1a\u5fc5\u5237\u7b2c\u4e00\u904d\uff0c\u8986\u76d6\u6700\u9ad8\u9891\u9898\u578b</li> <li>NeetCode 150\uff1a\u6309\u4e13\u9898\u5206\u597d\u7c7b\uff0c\u9002\u5408\u7cfb\u7edf\u6027\u8865\u5f31\u9879\uff0c\u7f51\u7ad9\u6709\u514d\u8d39\u8def\u7ebf\u56fe</li> <li>Grind 75 / Blind 75\uff1a\u65f6\u95f4\u7d27\u65f6\u7684\u6d53\u7f29\u7248\uff0c\u548c NeetCode \u9ad8\u5ea6\u91cd\u5408</li> </ul>"},{"location":"method/#_5","title":"\u51b2\u523a","text":"<ul> <li>\u5404\u516c\u53f8 Tag \u9898\uff1aLeetCode \u6309\u516c\u53f8\u7b5b\u9009\u7684\u9ad8\u9891\u9898\uff08Google\u3001Meta\u3001Amazon\u3001TikTok \u8fd1\u534a\u5e74\u9ad8\u9891\uff09\uff0c\u51b2\u523a\u671f\u4e3b\u653b\u76ee\u6807\u516c\u53f8</li> </ul>"},{"location":"method/#_6","title":"\u8f85\u52a9","text":"<ul> <li>\u4e00\u4ea9\u4e09\u5206\u5730\uff1a\u770b\u5404\u516c\u53f8\u7684\u9762\u7ecf\u548c\u771f\u9898\uff0c\u4e2d\u6587\u793e\u533a\u5317\u7f8e\u6c42\u804c\u6700\u5168\uff0cOA \u539f\u9898\u7ecf\u5e38\u80fd\u641c\u5230</li> <li>LeetCode \u5468\u8d5b\uff1a\u540e\u671f\u7ec3\u901f\u5ea6\u548c\u4e34\u573a</li> </ul>"},{"location":"method/#_7","title":"\u6bcf\u9053\u9898\u7684\u6807\u51c6\u52a8\u4f5c\uff08\u51b3\u5b9a\u6210\u8d25\u7684\u90e8\u5206\uff09","text":"<ol> <li>\u590d\u8ff0 + \u95ee\u7ea6\u675f\uff082 \u5206\u949f\uff09\uff1an \u7684\u8303\u56f4\uff1f\u662f\u5426\u6709\u5e8f\uff1f\u6709\u65e0\u91cd\u590d\uff1f\u7a7a\u8f93\u5165\uff1f\u4f1a\u4e0d\u4f1a\u6ea2\u51fa\uff1f</li> <li>\u8bf4\u66b4\u529b\u89e3 + \u590d\u6742\u5ea6\uff0830 \u79d2\u5185\uff09\uff0c\u4e0d\u8981\u6c89\u9ed8\u601d\u8003</li> <li>\u627e\u74f6\u9888 \u2192 \u7ed9\u4f18\u5316\u65b9\u5411\uff1a\u54c8\u5e0c\uff1f\u6392\u5e8f\uff1f\u4e8c\u5206\uff1fDP\uff1f\u53cc\u6307\u9488\uff1f</li> <li>\u5148\u8bb2\u65b9\u6848\u518d\u5199\u7801\uff0c\u8ba9\u9762\u8bd5\u5b98\u6709\u673a\u4f1a\u7ea0\u6b63\u4f60</li> <li>\u8fb9\u5199\u8fb9\u8bf4\uff0c\u53d8\u91cf\u547d\u540d\u6e05\u6670\uff0c\u4e0d\u70ab\u6280</li> <li>\u5199\u5b8c\u624b\u8dd1 2 \u4e2a\u4f8b\u5b50 + \u8fb9\u754c\uff1a\u7a7a\u3001\u5355\u5143\u7d20\u3001\u5168\u76f8\u540c\u3001\u6781\u503c</li> <li>\u4e3b\u52a8\u62a5\u590d\u6742\u5ea6 + follow-up\uff1a\"\u5982\u679c\u8fd9\u662f\u6570\u636e\u6d41\u5462\uff1f\"\"\u5982\u679c\u5185\u5b58\u653e\u4e0d\u4e0b\u5462\uff1f\"</li> <li>25 \u5206\u949f\u6ca1\u601d\u8def\u5c31\u8981\u63d0\u793a\uff0c\u786c\u6491\u6263\u5206\uff1b\u6c9f\u901a\u672c\u8eab\u662f\u8bc4\u5206\u9879</li> </ol>"},{"location":"mistakes/","title":"\u9519\u9898\u672c","text":"<p>\u8bb0\u5f55\u5361\u8fc7\u7684\u70b9\u548c\u9700\u8981\u91cd\u505a\u7684\u9898\uff0c\u6bcf\u5468\u56de\u987e\u4e00\u6b21\u3002</p> \u65e5\u671f \u9898\u76ee \u5361\u5728\u54ea \u6b63\u786e\u601d\u8def \u91cd\u505a"},{"location":"data-structures/","title":"\u6570\u636e\u7ed3\u6784","text":"<p>\u6bcf\u79cd\u7ed3\u6784\u8bb0\u4e09\u4ef6\u4e8b\uff1a\u80fd\u505a\u4ec0\u4e48\u3001\u64cd\u4f5c\u591a\u5feb\u3001Python \u600e\u4e48\u5199\u3002</p> \u7ed3\u6784 \u64c5\u957f \u5173\u952e\u64cd\u4f5c\u590d\u6742\u5ea6 Python \u6570\u7ec4 / \u5217\u8868 \u6309\u4e0b\u6807\u8bbf\u95ee \u8bbf\u95ee O(1)\uff0c\u4e2d\u95f4\u63d2\u5165 O(n) <code>list</code> \u54c8\u5e0c\u8868 \u67e5\u201c\u89c1\u6ca1\u89c1\u8fc7\u201d \u67e5\u627e / \u63d2\u5165 O(1) <code>dict</code>\u3001<code>set</code> \u6808 \u540e\u8fdb\u5148\u51fa\uff0c\u62ec\u53f7\u3001\u64a4\u9500 \u538b\u5165 / \u5f39\u51fa O(1) <code>list.append</code> / <code>pop</code> \u961f\u5217 \u5148\u8fdb\u5148\u51fa\uff0cBFS \u5165\u961f / \u51fa\u961f O(1) <code>collections.deque</code> \u5806 \u968f\u65f6\u53d6\u6700\u5c0f / \u6700\u5927 \u53d6\u9876 O(1)\uff0c\u63d2\u5165 / \u5f39\u51fa O(log n) <code>heapq</code> \u94fe\u8868 \u9891\u7e41\u63d2\u5165\u5220\u9664 \u63d2\u5165 O(1)\uff0c\u67e5\u627e O(n) \u81ea\u5b9a\u4e49 <code>ListNode</code> \u4e8c\u53c9\u6811 \u5c42\u7ea7\u3001\u9012\u5f52\u7ed3\u6784 \u5e73\u8861\u65f6 O(log n) \u81ea\u5b9a\u4e49 <code>TreeNode</code> \u56fe \u5173\u7cfb\u3001\u8def\u5f84 \u904d\u5386 O(V + E) \u90bb\u63a5\u8868 <code>dict[list]</code> <p>\u5b66\u4e60\u987a\u5e8f</p> <p>\u6570\u7ec4 / \u54c8\u5e0c\u8868 \u2192 \u6808 / \u961f\u5217 \u2192 \u94fe\u8868 \u2192 \u4e8c\u53c9\u6811\uff08\u9012\u5f52\u662f\u5173\u952e\uff09\u2192 \u5806 \u2192 \u56fe</p>"},{"location":"patterns/","title":"\u7b97\u6cd5\u5957\u8def","text":"<p>\u6bcf\u4e2a\u5957\u8def\u8bb0\uff1a\u8bc6\u522b\u4fe1\u53f7\uff08\u770b\u5230\u4ec0\u4e48\u5c31\u8be5\u60f3\u5230\u5b83\uff09\u3001\u6a21\u677f\u3001\u4ee3\u8868\u9898\u3002</p> \u5957\u8def \u8bc6\u522b\u4fe1\u53f7 \u4ee3\u8868\u9898 \u53cc\u6307\u9488 \u6709\u5e8f\u6570\u7ec4\u3001\u4e24\u7aef\u903c\u8fd1\u3001\u539f\u5730\u4fee\u6539 Two Sum II\u3001Container With Most Water \u6ed1\u52a8\u7a97\u53e3 \u8fde\u7eed\u5b50\u6570\u7ec4 / \u5b50\u4e32\u3001\u201c\u6700\u957f / \u6700\u77ed\u6ee1\u8db3\u6761\u4ef6\u201d Longest Substring Without Repeating Characters \u4e8c\u5206\u67e5\u627e \u6709\u5e8f\u3001\u5355\u8c03\u3001\u201c\u6700\u5c0f\u7684\u6ee1\u8db3\u6761\u4ef6\u7684\u503c\u201d Binary Search\u3001Koko Eating Bananas BFS \u6700\u77ed\u6b65\u6570\u3001\u5c42\u5e8f Binary Tree Level Order Traversal\u3001Rotting Oranges DFS / \u56de\u6eaf \u5217\u51fa\u6240\u6709\u65b9\u6848\u3001\u6392\u5217\u7ec4\u5408 Subsets\u3001Permutations \u52a8\u6001\u89c4\u5212 \u6c42\u6700\u503c / \u65b9\u6848\u6570\uff0c\u95ee\u9898\u53ef\u62c6\u6210\u91cd\u53e0\u5b50\u95ee\u9898 Climbing Stairs\u3001House Robber \u5355\u8c03\u6808 \u201c\u4e0b\u4e00\u4e2a\u66f4\u5927 / \u66f4\u5c0f\u7684\u5143\u7d20\u201d Daily Temperatures \u62d3\u6251\u6392\u5e8f \u4f9d\u8d56\u5173\u7cfb\u3001\u5148\u4fee\u8bfe\u7a0b Course Schedule \u5e76\u67e5\u96c6 \u8fde\u901a\u6027\u3001\u5206\u7ec4 Number of Provinces"},{"location":"patterns/#_2","title":"\u6a21\u677f\u793a\u4f8b\uff1a\u6ed1\u52a8\u7a97\u53e3","text":"<pre><code>def sliding_window(s):\n    window = {}\n    left = 0\n    best = 0\n    for right, ch in enumerate(s):\n        window[ch] = window.get(ch, 0) + 1          # \u53f3\u8fb9\u6269\n        while window[ch] &gt; 1:                        # \u4e0d\u6ee1\u8db3\u6761\u4ef6\u5c31\u6536\u7f29\n            window[s[left]] -= 1\n            left += 1\n        best = max(best, right - left + 1)           # \u66f4\u65b0\u7b54\u6848\n    return best\n</code></pre>"},{"location":"problems/","title":"\u5237\u9898\u8bb0\u5f55","text":"<p>\u4e00\u9898\u4e00\u9875\uff0c\u6587\u4ef6\u540d\u7528 <code>\u9898\u53f7-\u82f1\u6587\u540d.md</code>\uff0c\u4f8b\u5982 <code>0001-two-sum.md</code>\u3002\u65b0\u5efa\u65f6\u590d\u5236\u7b14\u8bb0\u6a21\u677f\u3002</p> # \u9898\u76ee \u5957\u8def \u96be\u5ea6 \u72b6\u6001 1 Two Sum \u54c8\u5e0c\u8868 Easy \u2705 <p>\u72b6\u6001\uff1a\u2705 \u80fd\u72ec\u7acb\u5199\u51fa \u00b7 \ud83d\udd01 \u9700\u8981\u91cd\u505a \u00b7 \u274c \u8fd8\u4e0d\u4f1a</p>"},{"location":"problems/0001-two-sum/","title":"1. Two Sum","text":"<ul> <li>\u94fe\u63a5\uff1ahttps://leetcode.com/problems/two-sum/</li> <li>\u5957\u8def\uff1a\u54c8\u5e0c\u8868</li> <li>\u96be\u5ea6\uff1aEasy</li> </ul>"},{"location":"problems/0001-two-sum/#_1","title":"\u4e09\u95ee","text":"<ol> <li>\u66b4\u529b\u89e3\u662f\u4ec0\u4e48\uff1f \u4e24\u5c42\u5faa\u73af\uff0c\u679a\u4e3e\u6240\u6709\u4e24\u4e2a\u6570\u7684\u7ec4\u5408\uff0cO(n\u00b2)</li> <li>\u66b4\u529b\u6162\u5728\u54ea\uff1f \u6bcf\u5230\u4e00\u4e2a\u6570\uff0c\u90fd\u8981\u4ece\u5934\u518d\u627e\u4e00\u904d\u201c\u53e6\u4e00\u4e2a\u6570\u201d</li> <li>\u7528\u4ec0\u4e48\u529e\u6cd5\u53bb\u6389\u91cd\u590d\uff1f \u7528\u54c8\u5e0c\u8868\u8bb0\u4f4f\u89c1\u8fc7\u7684\u6570\u548c\u4e0b\u6807\uff0c\u6bcf\u4e2a\u6570\u53ea\u9700\u67e5\u4e00\u6b21\u201c<code>target - x</code> \u89c1\u8fc7\u6ca1\u6709\u201d\uff0cO(n)</li> </ol>"},{"location":"problems/0001-two-sum/#_2","title":"\u4ee3\u7801","text":"<pre><code>def twoSum(nums, target):\n    seen = {}                      # \u503c -&gt; \u4e0b\u6807\n    for i, x in enumerate(nums):\n        if target - x in seen:\n            return [seen[target - x], i]\n        seen[x] = i                # \u5148\u67e5\u518d\u5b58\uff0c\u907f\u514d\u81ea\u5df1\u914d\u81ea\u5df1\n    return []\n</code></pre>"},{"location":"problems/0001-two-sum/#_3","title":"\u590d\u6742\u5ea6","text":"<ul> <li>\u65f6\u95f4\uff1aO(n)</li> <li>\u7a7a\u95f4\uff1aO(n)</li> </ul>"},{"location":"problems/0001-two-sum/#_4","title":"\u5361\u70b9","text":"<ul> <li>\u5148\u67e5\u518d\u5b58\u7684\u987a\u5e8f\uff1a\u5982\u679c\u5148\u5b58\uff0c<code>nums = [3]</code>\u3001<code>target = 6</code> \u65f6\u4f1a\u628a 3 \u548c\u81ea\u5df1\u914d\u6210\u4e00\u5bf9</li> </ul>"},{"location":"problems/template/","title":"\u9898\u53f7. \u9898\u76ee\u540d","text":"<ul> <li>\u94fe\u63a5\uff1a</li> <li>\u5957\u8def\uff1a</li> <li>\u96be\u5ea6\uff1a</li> <li>\u65e5\u671f\uff1a</li> </ul>"},{"location":"problems/template/#_2","title":"\u4e09\u95ee","text":"<ol> <li>\u66b4\u529b\u89e3\u662f\u4ec0\u4e48\uff1f</li> <li>\u66b4\u529b\u6162\u5728\u54ea\uff1f\uff08\u91cd\u590d\u8ba1\u7b97\u4e86\u4ec0\u4e48\uff09</li> <li>\u7528\u4ec0\u4e48\u529e\u6cd5\u53bb\u6389\u91cd\u590d\uff1f</li> </ol>"},{"location":"problems/template/#_3","title":"\u4ee3\u7801","text":""},{"location":"problems/template/#_4","title":"\u590d\u6742\u5ea6","text":"<ul> <li>\u65f6\u95f4\uff1a</li> <li>\u7a7a\u95f4\uff1a</li> </ul>"},{"location":"problems/template/#_5","title":"\u5361\u70b9","text":""},{"location":"problems/template/#_6","title":"\u590d\u4e60\u8bb0\u5f55","text":"<ul> <li> 3 \u5929\u540e\u91cd\u505a</li> <li> 1 \u5468\u540e\u91cd\u505a</li> <li> 2 \u5468\u540e\u91cd\u505a</li> </ul>"}]}