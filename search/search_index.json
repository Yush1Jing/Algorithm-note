{"config":{"lang":["zh","en"],"separator":"[\\s\\u200b\\u3000\\-\u3001\u3002\uff0c\uff0e\uff1f\uff01\uff1b]+","pipeline":["stemmer"],"fields":{"title":{"boost":1000.0},"text":{"boost":1.0},"tags":{"boost":1000000.0}}},"docs":[{"location":"","title":"\u9996\u9875","text":""},{"location":"#algorithm-notes","title":"Algorithm Notes","text":"<p>\u6211\u7684\u7b97\u6cd5\u4e0e\u5237\u9898\u5b66\u4e60\u8bb0\u5f55\uff1a\u4ece\u6570\u636e\u7ed3\u6784\u57fa\u7840\uff0c\u5230\u5e38\u89c1\u7b97\u6cd5\u5957\u8def\uff0c\u518d\u5230\u6bcf\u9053\u9898\u7684\u601d\u8def\u590d\u76d8\u3002</p>"},{"location":"#_1","title":"\u680f\u76ee","text":"\u680f\u76ee \u5185\u5bb9 \u5237\u9898\u65b9\u6cd5 \u77e5\u8bc6\u70b9\u6e05\u5355\u3001\u9898\u5e93\u8def\u7ebf\u3001\u6bcf\u9053\u9898\u7684\u6807\u51c6\u9762\u8bd5\u52a8\u4f5c \u6570\u636e\u7ed3\u6784 \u6bcf\u79cd\u7ed3\u6784\u80fd\u505a\u4ec0\u4e48\u3001\u64cd\u4f5c\u590d\u6742\u5ea6\u3001Python \u5199\u6cd5 \u7b97\u6cd5\u5957\u8def \u53cc\u6307\u9488\u3001BFS\u3001\u4e8c\u5206\u3001DP \u7b49\u6a21\u677f\u548c\u8bc6\u522b\u4fe1\u53f7 \u5237\u9898\u8bb0\u5f55 \u4e00\u9898\u4e00\u9875\uff1a\u66b4\u529b\u89e3 \u2192 \u74f6\u9888 \u2192 \u4f18\u5316 \u9519\u9898\u672c \u5361\u8fc7\u7684\u70b9\uff0c\u5b9a\u671f\u91cd\u505a"},{"location":"#_2","title":"\u5b66\u4e60\u539f\u5219","text":"<ul> <li>\u6a21\u677f\u8981\u80cc\uff0c\u601d\u8def\u8981\u61c2\uff1a\u80fd\u7528\u4e09\u53e5\u8bdd\u8bb2\u6e05\u201c\u4e3a\u4ec0\u4e48\u7528\u8fd9\u4e2a\u65b9\u6cd5\u201d\u624d\u7b97\u61c2</li> <li>\u540c\u7c7b\u9898\u8fde\u7740\u505a\uff0c\u5230\u7b2c 4\u30015 \u9053\u5f00\u59cb\u81ea\u5df1\u60f3\u5230</li> <li>\u6bcf\u9053\u9898\u90fd\u5199\uff1a\u66b4\u529b\u89e3\u662f\u4ec0\u4e48\u3001\u6162\u5728\u54ea\u3001\u600e\u4e48\u53bb\u6389\u91cd\u590d</li> </ul>"},{"location":"00-preface/","title":"\u7b2c 0 \u7ae0 &nbsp; \u524d\u8a00","text":""},{"location":"00-preface/#0","title":"\u7b2c 0 \u7ae0 \u00a0 \u524d\u8a00","text":"<p>some notes </p>"},{"location":"01-data-structures/","title":"\u7b2c 1 \u7ae0 &nbsp; \u6570\u636e\u7ed3\u6784","text":""},{"location":"01-data-structures/#1","title":"\u7b2c 1 \u7ae0 \u00a0 \u6570\u636e\u7ed3\u6784","text":"<p>\u6bcf\u79cd\u7ed3\u6784\u8bb0\u4e09\u4ef6\u4e8b\uff1a\u80fd\u505a\u4ec0\u4e48\u3001\u64cd\u4f5c\u591a\u5feb\u3001Python \u600e\u4e48\u5199\u3002</p> \u7ed3\u6784 \u64c5\u957f \u5173\u952e\u64cd\u4f5c\u590d\u6742\u5ea6 Python \u6570\u7ec4 / \u5217\u8868 \u6309\u4e0b\u6807\u8bbf\u95ee \u8bbf\u95ee O(1)\uff0c\u4e2d\u95f4\u63d2\u5165 O(n) <code>list</code> \u54c8\u5e0c\u8868 \u67e5\u201c\u89c1\u6ca1\u89c1\u8fc7\u201d \u67e5\u627e / \u63d2\u5165 O(1) <code>dict</code>\u3001<code>set</code> \u6808 \u540e\u8fdb\u5148\u51fa\uff0c\u62ec\u53f7\u3001\u64a4\u9500 \u538b\u5165 / \u5f39\u51fa O(1) <code>list.append</code> / <code>pop</code> \u961f\u5217 \u5148\u8fdb\u5148\u51fa\uff0cBFS \u5165\u961f / \u51fa\u961f O(1) <code>collections.deque</code> \u5806 \u968f\u65f6\u53d6\u6700\u5c0f / \u6700\u5927 \u53d6\u9876 O(1)\uff0c\u63d2\u5165 / \u5f39\u51fa O(log n) <code>heapq</code> \u94fe\u8868 \u9891\u7e41\u63d2\u5165\u5220\u9664 \u63d2\u5165 O(1)\uff0c\u67e5\u627e O(n) \u81ea\u5b9a\u4e49 <code>ListNode</code> \u4e8c\u53c9\u6811 \u5c42\u7ea7\u3001\u9012\u5f52\u7ed3\u6784 \u5e73\u8861\u65f6 O(log n) \u81ea\u5b9a\u4e49 <code>TreeNode</code> \u56fe \u5173\u7cfb\u3001\u8def\u5f84 \u904d\u5386 O(V + E) \u90bb\u63a5\u8868 <code>dict[list]</code> <p>\u5b66\u4e60\u987a\u5e8f</p> <p>\u6570\u7ec4 / \u54c8\u5e0c\u8868 \u2192 \u6808 / \u961f\u5217 \u2192 \u94fe\u8868 \u2192 \u4e8c\u53c9\u6811\uff08\u9012\u5f52\u662f\u5173\u952e\uff09\u2192 \u5806 \u2192 \u56fe</p>"},{"location":"appendix/template/","title":"\u7b14\u8bb0\u6a21\u677f","text":""},{"location":"appendix/template/#_1","title":"\u7b14\u8bb0\u6a21\u677f","text":"<p>\u590d\u5236\u672c\u9875\u5185\u5bb9\u5230 <code>docs/03-problems/\u9898\u53f7-\u82f1\u6587\u540d.md</code>\uff0c\u518d\u5728 <code>mkdocs.yml</code> \u7684 nav \u91cc\u52a0\u4e00\u884c\u3002</p>"},{"location":"appendix/template/#3x","title":"3.x \u00a0 \u9898\u76ee\u540d","text":"<p>Question</p> <p>\u9898\u76ee\u63cf\u8ff0\uff08\u7528\u81ea\u5df1\u7684\u8bdd\u5199\uff09</p> <p>LeetCode \u9898\u53f7. \u9898\u76ee\u540d</p>"},{"location":"appendix/template/#_2","title":"\u4e09\u95ee","text":"<ol> <li>\u66b4\u529b\u89e3\u662f\u4ec0\u4e48\uff1f</li> <li>\u66b4\u529b\u6162\u5728\u54ea\uff1f\uff08\u91cd\u590d\u8ba1\u7b97\u4e86\u4ec0\u4e48\uff09</li> <li>\u600e\u4e48\u53bb\u6389\u91cd\u590d\uff1f</li> </ol>"},{"location":"appendix/template/#_3","title":"\u4ee3\u7801\u5b9e\u73b0","text":"Python"},{"location":"appendix/template/#_4","title":"\u590d\u6742\u5ea6\u5206\u6790","text":"<ul> <li>\u65f6\u95f4\u590d\u6742\u5ea6 \\( O(?) \\)\uff1a</li> <li>\u7a7a\u95f4\u590d\u6742\u5ea6 \\( O(?) \\)\uff1a</li> </ul> <p>\u5361\u70b9</p> <p>\u5361\u5728\u54ea\u3001\u600e\u4e48\u60f3\u901a\u7684</p>"},{"location":"appendix/template/#_5","title":"\u590d\u4e60\u8bb0\u5f55","text":"<ul> <li> 3 \u5929\u540e\u91cd\u505a</li> <li> 1 \u5468\u540e\u91cd\u505a</li> <li> 2 \u5468\u540e\u91cd\u505a</li> </ul>"}]}